# Configuración de Telegram
# Obtén el token de tu bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Obtén tu Chat ID con @userinfobot en Telegram
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Método de scraping: cloudscraper o playwright
SCRAPER_METHOD=cloudscraper

# Configuración opcional para Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=45000

# Activa logs de diagnóstico para MejorTorrent
SCRAPER_DIAGNOSTIC=false


